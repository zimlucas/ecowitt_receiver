# Copy this file to `.env` and fill in real values (`.env` is gitignored).
# In Netlify, set the same variables under:
#   Site configuration -> Environment variables.
#
# The two passwords and the API keys are REQUIRED for posting to work.

# Ecowitt Cloud API (from your ecowitt.net account)
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Windy PWS upload key (stations.windy.com -> API keys)
WINDY_API_KEY=

# Weather Underground (station ID is public; password is secret)
WU_ID=INAVEG5
WU_PASSWORD=

# Windguru (station UID is public; password is secret)
WG_UID=INAVEG5
WG_PASSWORD=

# Station metadata (optional — code has sensible defaults)
STATION_NAME=Meia Praia Soul
STATION_LAT=
STATION_LON=
STATION_ELEVATION=
STATION_TEMP_HEIGHT=
STATION_WIND_HEIGHT=
